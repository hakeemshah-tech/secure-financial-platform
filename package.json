{
  "name": "sft-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Secure Financial Platform: Next.js client and Node.js/TypeScript transaction-validation server.",
  "author": "Hakeem Shah <hakeemshah.tech@outlook.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakeemshah-tech/secure-financial-platform.git"
  },
  "workspaces": [
    "sft-client",
    "sft-server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev --workspace=sft-client",
    "dev:server": "npm run dev --workspace=sft-server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=sft-client",
    "build:server": "npm run build --workspace=sft-server",
    "start:server": "npm run start --workspace=sft-server",
    "start:client": "npm run start --workspace=sft-client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed --workspace=sft-server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
